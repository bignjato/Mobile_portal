{
  "expo": {
    "name": "VTS Portal",
    "slug": "vts-mobilni-portal",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E40AF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "hr.ekoflor.vts",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "VTS koristi GPS za bilježenje dolaska na lokaciju radnog naloga.",
        "NSLocationAlwaysUsageDescription": "VTS koristi GPS za praćenje rute i bilježenje dolaska.",
        "NSCameraUsageDescription": "VTS koristi kameru za skeniranje barcoda i fotografiranje nepravilnosti."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E40AF"
      },
      "package": "hr.ekoflor.vts",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-camera",
        {
          "cameraPermission": "VTS koristi kameru za skeniranje barcoda."
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ],
    "scheme": "vts",
    "extra": {
      "API_BASE_URL": "https://api.vas-portal.hr",
      "API_VERSION": "v1"
    }
  }
}
